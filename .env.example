# Copy this file to .env and fill in your own values. Never commit .env.
# .env is for LOCAL development only. Never put a Supabase connection string here: set those in
# Vercel, or for a single command (README, Deployment). The full variable table is in the README.

# Local PostgreSQL for the app, migrations and the seed.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/goodcane_drops

# Optional. Migrations and the seed use this instead of DATABASE_URL when it is set (on Supabase:
# the session pooler string, set for one command only). Leave it out locally.
# MIGRATION_DATABASE_URL=

# Optional. "transaction" forces the transaction-pooler settings (no prepared statements, one
# connection) against any database, used to prove locally that they change nothing.
# DATABASE_POOL_MODE=

# Keep true for the demo: sample data, simulated payments, no real messages.
DEMO_MODE=true

# Your own WhatsApp number in international format, digits only. Every wa.me link uses it in demo
# mode. Empty hides the "Send to my WhatsApp" button (as on the deployed demo).
DEMO_WHATSAPP_NUMBER=

# Passcode for the owner screens (/owner). A demo passcode shown to reviewers: never a password you
# use anywhere else. Leave it empty and nobody can open the owner screens.
OWNER_PASSCODE=

# true only when deployed on Vercel: the owner login limit then reads the client address from the
# x-vercel-forwarded-for header Vercel sets. Anywhere else keep false (the connection address is used).
# Other forwarded headers such as X-Forwarded-For are never trusted.
TRUST_PROXY=false

# Public base URL of the app, used to build private links.
APP_URL=http://localhost:3000

# Separate database for integration and API tests. Its name must end in _test, or the tests refuse to run.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/goodcane_drops_test

# Not a setting to keep here: ALLOW_REMOTE_DB=true is set for one command only, to let pnpm seed or
# pnpm db:migrate change a remote database such as Supabase. Without it they refuse.
